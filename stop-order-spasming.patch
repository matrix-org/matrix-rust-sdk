+        );
+
+        // Now `room_a` gets a latest event NEWER than everything (ts 400): it
+        // must move to the front in one atomic batch.
+        set_latest_event(&mut room_a, remote(400)).await;
+
+        sender
+            .send(vec![VectorDiff::Set { index: 0, value: room_a.clone() }])
+            .await
+            .unwrap();
